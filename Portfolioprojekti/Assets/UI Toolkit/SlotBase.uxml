<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/SlotStyle.uss?fileID=7433441132597879392&amp;guid=73f5a62400c990c8899673568bb4a3a4&amp;type=3#SlotStyle"/>
    <ui:VisualElement name="SlotContainer" class="slot-container">
        <ui:VisualElement name="PlayField" class="playfield" style="flex-grow: 1;">
            <ui:VisualElement name="Reel1" class="reel" style="flex-grow: 1;">
                <ui:VisualElement name="IconHolder" class="icon-holder" style="translate: 0 -1px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Reel2" class="reel" style="flex-grow: 1;">
                <ui:VisualElement name="IconHolder" class="icon-holder" style="translate: 0 -1px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Reel3" class="reel" style="flex-grow: 1;">
                <ui:VisualElement name="IconHolder" class="icon-holder" style="translate: 0 -1px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Reel4" class="reel" style="flex-grow: 1;">
                <ui:VisualElement name="IconHolder" class="icon-holder" style="translate: 0 -1px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Reel5" class="reel" style="flex-grow: 1;">
                <ui:VisualElement name="IconHolder" class="icon-holder" style="translate: 0 -1px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="UIButtons" class="ui-buttons-container" style="flex-grow: 1;">
            <ui:VisualElement name="Saldo" class="saldo">
                <ui:Label text="Saldo: 1000€" name="SaldoText"/>
            </ui:VisualElement>
            <ui:VisualElement name="UIMiddle" class="ui-middle">
                <ui:VisualElement name="TextBar" class="text-bar" style="flex-grow: 1;">
                    <ui:Label text="Onnea peliin :D" name="TextBarText"/>
                </ui:VisualElement>
                <ui:VisualElement name="ButtonHolder" class="button-holder">
                    <ui:VisualElement name="BetAmount">
                        <ui:Label text="Label" name="ButtonTitle" class="button-title"/>
                        <ui:VisualElement name="Buttons" class="increment-buttons-container">
                            <ui:Button text="" name="Left" class="left-button"/>
                            <ui:Label text="Label" name="Value" class="button-value"/>
                            <ui:Button text="" name="Right" class="right-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Winlines">
                        <ui:Label text="Label" name="ButtonTitle" class="button-title"/>
                        <ui:VisualElement name="Buttons" class="increment-buttons-container">
                            <ui:Button text="" name="Left" class="left-button"/>
                            <ui:Label text="Label" name="Value" class="button-value"/>
                            <ui:Button text="" name="Right" class="right-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Spin" name="SpinButton" class="spin"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
